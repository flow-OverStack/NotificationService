{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.File",
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Http"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "../NotificationService.Api/logs/log-.txt",
          "rollOnFileSizeLimit": true,
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact",
          "rollingInterval": "Day"
        }
      },
      {
        "Name": "Http",
        "Args": {
          "requestUri": "http://localhost:8003",
          "queueLimitBytes": null,
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithThreadId",
      "WithMachineName"
    ]
  },
  "KeycloakSettings": {
    "Host": "http://localhost:8080",
    "Realm": "flowOverStack",
    "Audience": "frontend"
  },
  "KafkaSettings": {
    "Host": "localhost:9092",
    "BaseEventTopic": "base-event-topic",
    "BaseEventConsumerGroup": "notification-service-base-event-group",
    "DeadLetterTopic": "dead-letter-topic"
  },
  "AppStartupSettings": {
    "AppStartupUrlLog": "Now listening on: ",
    "KnownProxies": [
      "::1",
      "127.0.0.1"
    ],
    "TelemetrySettings": {
      "AspireDashboardUrl": "http://localhost:18889",
      "JaegerUrl": "http://localhost:4317",
      "ElasticSearchUrl": "http://localhost:9200",
      "LogstashUrl": "http://localhost:8003",
      "PrometheusUrl": "http://localhost:9090",
      "AspireDashboardHealthCheckUrl": "http://localhost:18888",
      "JaegerHealthCheckUrl": "http://localhost:16686",
      "UserServiceHealthCheckUrl": "http://localhost:8085/health",
      "QuestionServiceHealthCheckUrl": "http://localhost:8087/health",
      "AnswerServiceHealthCheckUrl" : "http://localhost:8089/health"
    },
    "CorsAllowedOrigins": [
      "https://frontend.flowoverstack.com"
    ]
  },
  "RedisSettings": {
    "Host": "localhost",
    "Port": 6382,
    "TimeToLiveInSeconds": 150,
    "NullTimeToLiveInSeconds": 30
  },
  "PaginationRules": {
    "MaxPageSize": 100,
    "DefaultPageSize": 20
  },
  "AllowedHosts": "*"
}
